+/* Put a copy of the cutbuffer onto the system clipboard, by way of the
+ * OSC 52 escape sequence, which the terminal passes to the clipboard. */
+void export_cutbuffer(void)
+{
+	static const char *base64 =
+				"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	size_t length = 0, index = 0;
+	char *text, *coded, *spot;
+
+	if (cutbuffer == NULL)
+		return;
+
+	/* Join the lines of the cutbuffer, separated by newlines. */
+	for (linestruct *line = cutbuffer; line != NULL; line = line->next)
+		length += strlen(line->data) + 1;
+
+	/* Avoid choking the terminal with an overlong sequence. */
+	if (--length > 100000) {
+		statusline(AHEM, _("Too much text for the system clipboard"));
+		return;
+	}
+
+	text = nmalloc(length + 1);
+	spot = text;
+
+	for (linestruct *line = cutbuffer; line != NULL; line = line->next) {
+		spot = stpcpy(spot, line->data);
+		if (line->next)
+			*(spot++) = '\n';
+	}
+
+	coded = nmalloc((length + 2) / 3 * 4 + 1);
+	spot = coded;
+
+	/* Encode each group of three bytes as four base64 characters. */
+	while (index < length) {
+		unsigned long triplet = (unsigned char)text[index++] << 16;
+
+		if (index < length)
+			triplet |= (unsigned char)text[index] << 8;
+		if (index + 1 < length)
+			triplet |= (unsigned char)text[index + 1];
+
+		*(spot++) = base64[(triplet >> 18) & 0x3F];
+		*(spot++) = base64[(triplet >> 12) & 0x3F];
+		*(spot++) = (index < length) ? base64[(triplet >> 6) & 0x3F] : '=';
+		*(spot++) = (index + 1 < length) ? base64[triplet & 0x3F] : '=';
+		index += 2;
+	}
+	*spot = '\0';
+
+	printf("\x1B]52;c;%s\x07", coded);
+	fflush(stdout);
+
+	free(text);
+	free(coded);
+}
+#endif
