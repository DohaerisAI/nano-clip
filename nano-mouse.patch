 /* Handle a mouse click on the edit window or the shortcut list. */
 int do_mouse(void)
 {
 	int click_row, click_col;
 	int retval = get_mouseinput(&click_row, &click_col, TRUE);
 
+#ifndef NANO_TINY
+	/* A press of the first button in the edit window may begin a drag. */
+	if (retval == 3) {
+		linestruct *current_save = openfile->current;
+		size_t current_x_save = openfile->current_x;
+		bool had_selection = (openfile->mark && openfile->softmark);
+		linestruct *top, *bot;
+		size_t top_x, bot_x;
+		int presses;
+
+		drag_interrupted = FALSE;
+
+		if (!wmouse_trafo(midwin, &click_row, &click_col, FALSE))
+			return 2;
+
+		/* With Shift or Alt held, extend the selection to the clicked spot,
+		 * starting one at the cursor when there is none. */
+		if (mouse_with_modifier()) {
+			pressed_row = -1;
+
+			if (!openfile->mark) {
+				openfile->mark = openfile->current;
+				openfile->mark_x = openfile->current_x;
+				openfile->softmark = TRUE;
+			}
+
+			top = openfile->mark;
+			top_x = openfile->mark_x;
+
+			move_cursor_to_spot(click_row, click_col);
+			edit_redraw(current_save, CENTERING);
+			refresh_needed = TRUE;
+
+			drag_to_select(BY_CHARS, top, top_x, top, top_x, TRUE);
+			hint_at_selection();
+			keep_cutbuffer = FALSE;
+			return 2;
+		}
+
+		presses = count_presses(click_row, click_col);
+
+		/* Like a cursor movement, a click discards a shifted selection. */
+		if (had_selection) {
+			openfile->mark = NULL;
+			refresh_needed = TRUE;
+		}
+
+		move_cursor_to_spot(click_row, click_col);
+		edit_redraw(current_save, CENTERING);
+
+		/* A double click selects a word, a triple click a whole line. */
+		if (presses > 1) {
+			unit_around(presses, openfile->current, openfile->current_x,
+										&top, &top_x, &bot, &bot_x);
+			openfile->mark = top;
+			openfile->mark_x = top_x;
+			openfile->softmark = TRUE;
+			openfile->current = bot;
+			openfile->current_x = bot_x;
+			edit_redraw(current_save, FLOWING);
+			refresh_needed = TRUE;
+
+			if (drag_to_select(presses, top, top_x, bot, bot_x, TRUE))
+				pressed_row = -1;
+
+			hint_at_selection();
+			keep_cutbuffer = FALSE;
+			return 2;
+		}
+
+		if (drag_to_select(BY_CHARS, openfile->current, openfile->current_x,
+								openfile->current, openfile->current_x, FALSE)) {
+			pressed_row = -1;
+			hint_at_selection();
+		}
+		/* Clicking where the cursor is toggles the mark, as does clicking
+		 * beyond the line length with the cursor at the end of the line. */
+		else if (!had_selection && openfile->current == current_save &&
+									openfile->current_x == current_x_save) {
+			do_mark();
+			if (ISSET(STATEFLAGS))
+				titlebar(NULL);
+			return 2;
+		}
+
+		/* The cursor moved; clean the cutbuffer on the next cut. */
+		keep_cutbuffer = FALSE;
+		return 2;
+	}
+
+	/* When a drag was interrupted, ignore the release of the button. */
+	if (retval == 0 && drag_interrupted) {
+		drag_interrupted = FALSE;
+		return 2;
+	}
+#endif
