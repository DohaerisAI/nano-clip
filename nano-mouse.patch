+/* Move the cursor to the given row and column of the edit window.  The row
+ * may lie just outside of the window, which makes the viewport scroll. */
+static void move_cursor_to_spot(int row, int col)
+{
+	ssize_t row_count = row - openfile->current_y;
+	size_t leftedge;
+
+#ifndef NANO_TINY
+	if (ISSET(SOFTWRAP))
+		leftedge = leftedge_for(xplustabs(), openfile->current);
+	else
+#endif
+		leftedge = get_page_start(xplustabs());
+
+	/* Move current up or down to the row that was clicked on. */
+	if (row_count < 0)
+		go_back_chunks(-row_count, &openfile->current, &leftedge);
+	else
+		go_forward_chunks(row_count, &openfile->current, &leftedge);
+
+	openfile->current_x = actual_x(openfile->current->data,
+							actual_last_column(leftedge, (col < 0) ? 0 : col));
+}
+
+#ifndef NANO_TINY
+/* Whether a drag was cut short, so that its button release gets ignored. */
+static bool drag_interrupted = FALSE;
+
+/* The units by which a mouse selection grows; also the number of clicks. */
+#define BY_CHARS  1
+#define BY_WORDS  2
+#define BY_LINES  3
+
+/* The spot and time of the latest press of the first mouse button. */
+static int pressed_row = -1, pressed_col = -1, press_count = 0;
+static struct timespec pressed_time;
+
+/* Return how many times in a row (1 to 3) the first mouse button has been
+ * pressed on the given spot, each press within half a second of the last. */
+static int count_presses(int row, int col)
+{
+	struct timespec now;
+	long elapsed;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	elapsed = (now.tv_sec - pressed_time.tv_sec) * 1000 +
+				(now.tv_nsec - pressed_time.tv_nsec) / 1000000;
+
+	if (row == pressed_row && col == pressed_col && elapsed < 500)
+		press_count = press_count % 3 + 1;
+	else
+		press_count = 1;
+
+	pressed_time = now;
+	pressed_row = row;
+	pressed_col = col;
+
+	return press_count;
+}
+
+/* Return 2 for a word character (including the underscore, as in names
+ * in code), 1 for a blank, and 0 for anything else. */
+static int kind_of_char(const char *spot)
+{
+	if (is_word_char(spot, FALSE) || *spot == '_')
+		return 2;
+	else
+		return (is_blank_char(spot) ? 1 : 0);
+}
+
+/* Determine the start and end of the unit (a single spot, a run of similar
+ * characters, or a whole line) that contains the given spot. */
+static void unit_around(int unit, linestruct *line, size_t x, linestruct **start,
+						size_t *start_x, linestruct **end, size_t *end_x)
+{
+	*start = line;
+	*end = line;
+	*start_x = x;
+	*end_x = x;
+
+	if (unit == BY_WORDS && (line->data[x] != '\0' || x > 0)) {
+		/* Beyond the end of the line, take the last run of characters. */
+		size_t spot = (line->data[x] == '\0') ? step_left(line->data, x) : x;
+		int kind = kind_of_char(line->data + spot);
+
+		*start_x = spot;
+		while (*start_x > 0 && kind_of_char(line->data +
+							step_left(line->data, *start_x)) == kind)
+			*start_x = step_left(line->data, *start_x);
+
+		*end_x = spot;
+		while (line->data[*end_x] != '\0' &&
+							kind_of_char(line->data + *end_x) == kind)
+			*end_x = step_right(line->data, *end_x);
+	} else if (unit == BY_LINES) {
+		*start_x = 0;
+		if (line->next) {
+			*end = line->next;
+			*end_x = 0;
+		} else
+			*end_x = strlen(line->data);
+	}
+}
+
+/* Make the selection run from the anchor (the region between top and bot)
+ * to the unit around the cursor, with the cursor at the far end. */
+static void stretch_selection(int unit, linestruct *top, size_t top_x,
+								linestruct *bot, size_t bot_x)
+{
+	linestruct *start, *end;
+	size_t start_x, end_x;
+
+	unit_around(unit, openfile->current, openfile->current_x,
+								&start, &start_x, &end, &end_x);
+
+	if (start->lineno < top->lineno || (start == top && start_x < top_x)) {
+		openfile->mark = bot;
+		openfile->mark_x = bot_x;
+		openfile->current = start;
+		openfile->current_x = start_x;
+	} else {
+		openfile->mark = top;
+		openfile->mark_x = top_x;
+		openfile->current = end;
+		openfile->current_x = end_x;
+	}
+}
+
+/* Follow the mouse while its first button is held down, selecting the text
+ * between the anchor (the region from top to bot) and the pointer, growing
+ * by the given unit.  When selecting is FALSE, the selection begins only
+ * when the pointer moves.  While the pointer rests above or below the text
+ * area, keep scrolling.  Return TRUE when the pointer moved. */
+static bool drag_to_select(int unit, linestruct *top, size_t top_x,
+						linestruct *bot, size_t bot_x, bool selecting)
+{
+	int toprow = getbegy(midwin);
+	int row = 0, col = 0, edge = 0;
+	bool moved = FALSE;
+	MEVENT event;
+
+	while (TRUE) {
+		linestruct *was_current = openfile->current;
+		linestruct *was_mark = openfile->mark;
+		size_t was_mark_x = openfile->mark_x;
+		int input;
+
+		if (refresh_needed)
+			edit_refresh();
+		else {
+			place_the_cursor();
+			wnoutrefresh(midwin);
+		}
+		doupdate();
+
+		/* Handle mouse events that came in together before reading more. */
+		if (mouse_event_waiting())
+			input = KEY_MOUSE;
+		else {
+			/* At an edge, wait only briefly, so that the scrolling
+			 * continues also when the pointer does not move. */
+			wtimeout(midwin, edge ? 50 : -1);
+			input = wgetch(midwin);
+			wtimeout(midwin, -1);
+		}
+
+		if (input == KEY_MOUSE) {
+			if (!fetch_mouse_event(&event))
+				continue;
+			if (event.bstate & (BUTTON1_RELEASED | BUTTON1_CLICKED))
+				break;
+			if (!(event.bstate & REPORT_MOUSE_POSITION))
+				continue;
+
+			row = event.y - toprow;
+			col = event.x - getbegx(midwin) - margin;
+
+			/* The pointer is at an edge when it is beyond the text area,
+			 * or on its first or last row when that is the screen edge. */
+			if (row < 0 || (row == 0 && toprow == 0))
+				edge = -1;
+			else if (row >= editwinrows || (row == editwinrows - 1 &&
+										toprow + editwinrows == LINES))
+				edge = 1;
+			else
+				edge = 0;
+		} else if (input != ERR) {
+			/* A keystroke ends the drag; let it be handled normally. */
+			put_back(input);
+			drag_interrupted = TRUE;
+			break;
+		} else if (the_window_resized) {
+			regenerate_screen();
+			drag_interrupted = TRUE;
+			break;
+		} else if (!edge)
+			continue;
+
+		/* Like a shifted selection, a dragged one goes away when the
+		 * cursor is moved without Shift. */
+		if (!moved && !selecting)
+			openfile->softmark = TRUE;
+		moved = TRUE;
+
+		/* At an edge, go one row beyond the visible ones, to scroll. */
+		move_cursor_to_spot((edge < 0) ? -1 : (edge > 0) ? editwinrows : row, col);
+		stretch_selection(unit, top, top_x, bot, bot_x);
+
+		if (openfile->mark != was_mark || openfile->mark_x != was_mark_x)
+			refresh_needed = TRUE;
+
+		edit_redraw(was_current, FLOWING);
+	}
+
+	return moved;
+}
+#endif
