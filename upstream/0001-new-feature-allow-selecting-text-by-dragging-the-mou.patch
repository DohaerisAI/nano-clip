 #ifdef ENABLE_MOUSE
+/* Mouse events that ncurses delivered together, the oldest one first. */
+static MEVENT mouse_events[8];
+static int mouse_events_fetched = 0, mouse_events_waiting = 0;
+
+/* Return TRUE when getmouse() returns a run of events oldest first, as
+ * ncurses does since its 20250913 patch.  Earlier, the newest came first. */
+static bool oldest_comes_first(void)
+{
+	static int answer = -1;
+
+	if (answer < 0) {
+		long patch = 0;
+
+#ifdef NCURSES_VERSION
+		answer = (sscanf(curses_version(), "ncurses %*d.%*d.%ld", &patch) != 1 ||
+						patch >= 20250913);
+#else
+		answer = TRUE;
+#endif
+	}
+
+	return answer;
+}
+
+/* Get the oldest mouse event that has not yet been handled.  When mouse
+ * events arrive in quick succession, ncurses reports them with a single
+ * KEY_MOUSE, and getmouse() then returns them one by one. */
+bool fetch_mouse_event(MEVENT *event)
+{
+	if (mouse_events_waiting == 0) {
+		mouse_events_fetched = 0;
+
+		while (mouse_events_fetched < 8 &&
+						getmouse(&mouse_events[mouse_events_fetched]) == OK)
+			mouse_events_fetched++;
+
+		if (!oldest_comes_first())
+			for (int one = 0, other = mouse_events_fetched - 1; one < other; one++, other--) {
+				MEVENT swap = mouse_events[one];
+
+				mouse_events[one] = mouse_events[other];
+				mouse_events[other] = swap;
+			}
+
+		mouse_events_waiting = mouse_events_fetched;
+	}
+
+	if (mouse_events_waiting == 0)
+		return FALSE;
+
+	*event = mouse_events[mouse_events_fetched - mouse_events_waiting--];
+	return TRUE;
+}
+
+/* Return TRUE when mouse events are waiting to be fetched. */
+bool mouse_event_waiting(void)
+{
+	return (mouse_events_waiting > 0);
+}
+
 /* Handle clicks of the first mouse button, and rolls of the mouse wheel.
  * Store the coordinates of the mouse event in `mouse_x` and `mouse_y`.
  * Return -1 on error, 0 if the mouse event needs handling, 1 if it has
- * been handled by putting back keystrokes, or 2 if it's been ignored. */
+ * been handled by putting back keystrokes, 2 if it's been ignored, or 3
+ * if the first button was pressed in the edit window (a possible drag). */
 int get_mouseinput(int *mouse_y, int *mouse_x)
 {
 	bool in_middle, in_footer;
 	MEVENT event;
 
 	/* First, get the actual mouse event. */
-	if (getmouse(&event) == ERR)
+	if (!fetch_mouse_event(&event))
 		return -1;
 
+	/* When more events came in together, have them handled next. */
+	if (mouse_event_waiting())
+		put_back(KEY_MOUSE);
+
 	in_middle = wenclose(midwin, event.y, event.x);
 	in_footer = wenclose(footwin, event.y, event.x);
 
@@ -1679,6 +1759,13 @@ int get_mouseinput(int *mouse_y, int *mouse_x)
 			/* Clicks outside of the bottom window are handled elsewhere. */
 			return 0;
 	}
+#ifndef NANO_TINY
+	/* A press of the first button in the text (not in the "scrollbar")
+	 * may start a drag. */
+	else if ((event.bstate & BUTTON1_PRESSED) && in_middle && currmenu == MMAIN &&
+								!(sidebar && event.x == (COLS - 1)))
+		return 3;
+#endif
 #if NCURSES_MOUSE_VERSION >= 2
 	/* Handle "presses" of the fourth and fifth mouse buttons
 	 * (upward and downward rolls of the mouse wheel). */

