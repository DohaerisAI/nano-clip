-		ssize_t row_count = click_row - openfile->cursor_row;
-		size_t leftedge;
 #ifndef NANO_TINY
+		ssize_t row_count = click_row - openfile->cursor_row;
 		size_t was_x = openfile->current_x;
-
-		if (ISSET(SOFTWRAP))
-			leftedge = leftedge_for(xplustabs(), openfile->current);
-		else
 #endif
-			leftedge = get_page_start(xplustabs());
-
