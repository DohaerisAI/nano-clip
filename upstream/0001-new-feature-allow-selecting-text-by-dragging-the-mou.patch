 /* Handle a mouse click in the edit window or the help lines. */
 int process_click(void)
 {
 	int click_row, click_col;
 	int retval = get_mouseinput(&click_row, &click_col);  /* Handles shortcuts. */
 
+#ifndef NANO_TINY
+	/* A press of the first button in the edit window may begin a drag. */
+	if (retval == 3) {
+		linestruct *was_current = openfile->current;
+		size_t was_x = openfile->current_x;
+		bool had_selection = (openfile->mark && openfile->softmark);
+
+		drag_interrupted = FALSE;
+
+		if (!wmouse_trafo(midwin, &click_row, &click_col, FALSE))
+			return 2;
+
+		/* Like a cursor movement, a click discards a shifted selection. */
+		if (had_selection) {
+			openfile->mark = NULL;
+			refresh_needed = TRUE;
+		}
+
+		move_cursor_to_spot(click_row, click_col);
+		edit_redraw(was_current, CENTERING);
+
+		/* Clicking there where the cursor is toggles the mark. */
+		if (!drag_to_select() && !had_selection &&
+						openfile->current == was_current && openfile->current_x == was_x) {
+			do_mark();
+			if (ISSET(STATEFLAGS))
+				titlebar(NULL);
+			return 2;
+		}
+
+		/* The cursor moved; clean the cutbuffer on the next cut. */
+		keep_cutbuffer = FALSE;
+		return 2;
+	}
+
+	/* When a drag was interrupted, ignore the release of the button. */
+	if (retval == 0 && drag_interrupted) {
+		drag_interrupted = FALSE;
+		return 2;
+	}
+#endif
+
 	/* If the click is wrong or already handled, we're done. */
 	if (retval != 0)
 		return retval;
